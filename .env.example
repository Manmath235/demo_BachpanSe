# Copy to .env (never commit it) and fill in from Supabase -> Project Settings -> API.
# Both the PWA and the admin panel read this file. The anon key is safe to ship to browsers;
# row-level security in supabase/schema.sql is what protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
